# 로컬 실행 전: 이 파일을 복사해 .env.local을 만들고 팀에서 공유한 값을 채운 뒤 서버를 (재)시작하세요.
#   cp .env.example .env.local
# NEXT_PUBLIC_* 값은 서버 시작/빌드 시점에 주입되므로, 값을 바꾸면 반드시 재시작해야 합니다.

# [필수] 백엔드 API 기본 주소 (예: https://<백엔드 호스트>/<teamId>)
NEXT_PUBLIC_API_BASE_URL=

# [선택] 서버 전용 API 주소. 비워 두면 NEXT_PUBLIC_API_BASE_URL을 사용합니다.
#        배포 환경에서 이미지 재빌드 없이 주소를 바꿀 때 사용합니다.
API_BASE_URL=

# 이 서비스의 주소 (OAuth 리다이렉트, 메타데이터에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 카카오 간편 로그인 (카카오 개발자 콘솔의 REST API 키와 등록된 Redirect URI)
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao

# [선택] true면 React Query Devtools를 띄웁니다.
NEXT_PUBLIC_ENABLE_REACT_QUERY_DEVTOOLS=false

# E2E 테스트(Playwright) 전용 계정. 팀에는 할 일 목록이 하나 이상 있어야 한다.
E2E_EMAIL=
E2E_PASSWORD=
E2E_TEAM_ID=
# 3000번 포트를 다른 프로젝트가 쓰고 있을 때만 지정 (기본 3000)
# E2E_PORT=3100
